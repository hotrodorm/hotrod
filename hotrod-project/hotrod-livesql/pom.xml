<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>hotrod-livesql</artifactId>
  <packaging>jar</packaging>

  <name>hotrod-livesql</name>
  <description>HotRod is an ORM for Java, Spring and SpringBoot.</description>
  <url>https://github.com/hotrodorm/hotrod</url>

  <parent>
    <groupId>org.hotrodorm.hotrod</groupId>
    <artifactId>hotrod-project</artifactId>
    <version>5.1.27</version>
  </parent>

  <properties>
    <junit.version>5.13.4</junit.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
  </properties>

  <dependencies>

    <!-- HotRod -->

    <dependency>
      <groupId>org.hotrodorm.hotrod</groupId>
      <artifactId>hotrod</artifactId>
      <version>5.1.27</version>
    </dependency>

    <dependency>
      <groupId>org.hotrodorm.hotrod</groupId>
      <artifactId>hotrod-dynamicsql</artifactId>
      <version>5.1.27</version>
    </dependency>

    <!-- Spring -->

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.2.224</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
    </plugins>
  </build>

  <profiles>

    <profile>
      <id>h2unit</id>

      <properties>
        <springboot.version>4.0.4</springboot.version>

        <configbasedir>src/gen/resources</configbasedir>
        <jdbcdrivergroupid>com.h2database</jdbcdrivergroupid>
        <jdbcdriverartifactid>h2</jdbcdriverartifactid>
        <jdbcdriverversion>2.2.224</jdbcdriverversion>

        <jdbcdriverclass>org.h2.Driver</jdbcdriverclass>
        <jdbcurl>jdbc:h2:mem:EXAMPLEDB;INIT=runscript from
          'src/gen/resources/build.sql';DB_CLOSE_DELAY=-1</jdbcurl>
        <jdbcusername>sa</jdbcusername>
        <jdbcpassword>""</jdbcpassword>
        <jdbcschema>PUBLIC</jdbcschema>
      </properties>

      <dependencies>
        <dependency>
          <groupId>${jdbcdrivergroupid}</groupId>
          <artifactId>${jdbcdriverartifactid}</artifactId>
          <version>${jdbcdriverversion}</version>
        </dependency>
      </dependencies>

      <build>
        <plugins>

          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <version>${springboot.version}</version>
            <configuration>
              <arguments>
                <argument>
                  --spring.config.location=${configbasedir}/</argument>
              </arguments>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>repackage</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.hotrodorm.hotrod</groupId>
            <artifactId>hotrod-maven-plugin</artifactId>
            <version>${project.version}</version>
            <configuration>
              <!--
              -->
              <configfile>${configbasedir}/layer.xml</configfile>
              <jdbcdriverclass>${jdbcdriverclass}</jdbcdriverclass>
              <jdbcurl>${jdbcurl}</jdbcurl>
              <jdbcusername>${jdbcusername}</jdbcusername>
              <jdbcpassword>${jdbcpassword}</jdbcpassword>
              <jdbcschema>${jdbcschema}</jdbcschema>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>${jdbcdrivergroupid}</groupId>
                <artifactId>${jdbcdriverartifactid}</artifactId>
                <version>${jdbcdriverversion}</version>
              </dependency>
            </dependencies>
          </plugin>

        </plugins>
      </build>

    </profile>

    <profile>
      <id>release-gurus</id>

      <build>

        <plugins>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>splitter-exec</id>
                <phase>package</phase>
                <goals>
                  <goal>java</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includePluginDependencies>true</includePluginDependencies>
              <mainClass>org.nocrala.tools.jarsplitter.Shell</mainClass>
              <arguments>
                <argument /> <!-- Empty: to scan and discover all
								versions -->
                <argument>15</argument>
                <argument>org.hotrod.runtime.livesql</argument>
                <argument>${project.basedir}/target/rejar</argument>
                <argument>
                  ${project.basedir}/target/${project.artifactId}-${project.version}.jar</argument>
                <argument>${project.groupId}</argument>
                <argument>${project.artifactId}</argument>
                <argument>${project.version}</argument>
                <argument>all</argument> <!-- base-only, all -->
              </arguments>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.nocrala.tools</groupId>
                <artifactId>jar-splitter</artifactId>
                <version>1.0.4-SNAPSHOT</version>
              </dependency>
            </dependencies>
          </plugin>

          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>attach-artifacts</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>
                        ${project.basedir}/target/hotrod-livesql-hypersql2-4.0.1-SNAPSHOT.jar</file>
                      <type>jar</type>
                      <classifier>hypersql-2+</classifier>
                    </artifact>
                    <artifact>
                      <file>
                        ${project.basedir}/target/hotrod-livesql-postgresql15-4.0.1-SNAPSHOT.jar</file>
                      <type>jar</type>
                      <classifier>postgresql-15+</classifier>
                    </artifact>
                    <!-- 
                <artifact>
                    <file>${project.basedir}/target/hotrod-livesql-postgresql15-rp-4.0.1-SNAPSHOT.jar</file>
                  <type>jar</type>
                  <classifier>postgresql-15+-rp</classifier>
                </artifact>
                 -->
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>

      </build>


    </profile>

  </profiles>

</project>
