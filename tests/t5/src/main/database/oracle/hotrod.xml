<hotrod>

  <generators>
    <jdbc>
      <daos package="app.daos" dao-suffix="DAO" vo-suffix="" abstract-vo-prefix="" abstract-vo-suffix="Prototype" />
    </jdbc>
  </generators>
  
  <type-solver>
    <when test="typeName == 'DATE'" java-type="java.sql.Date" />
  </type-solver>

  <converter name="boolean_stored_as_int"
    java-type="java.lang.Boolean"
    java-raw-type="java.lang.Integer"
    class="app.IntegerBooleanConverter"
  />

