  <name-solver>
  <!-- 
    <name value="pty_(.+)" replace="$1" scope="table" />
    <name value="(.+)_house" replace="$1_estate" scope="table" />
 -->
    <name value="(.+)_CODE" replace="$1_NUMBER" scope="view" />
    <name value="(.+)_Code" replace="$1_KODE2" scope="column" />
    <name value="(.+)_code" replace="$1_KODE3" scope="column" />
  </name-solver>

  <runtime-type-solver>
  <!-- 
    <when test="scale > 0" java-type="java.math.BigDecimal" />
  -->
    <when test="precision &lt; 20" java-type="Long" />
    <when test="scale > 0" java-type="Short" />
  </runtime-type-solver>

  <converter name="boolean_stored_as_int" type="java.lang.Boolean" raw-type="java.lang.Integer"
    class="app.IntegerBooleanConverter" />

  <converter name="account_type_stored_as_char" type="app.AccountTypeConverter.AccountType"
    raw-type="java.lang.String" class="app.AccountTypeConverter" />

  <converter name="coin_type_stored_as_char" type="java.lang.Integer" raw-type="java.lang.String"
    class="app.CoinTypeConverter" />


  <converter name="active_stored_as_int" type="app.ActiveEnum" raw-type="java.lang.Integer"
    class="app.IntegerActiveConverter" />

