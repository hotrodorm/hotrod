<hotrod>

  <generators>
    <jdbc>
      <daos package="app.daos" />
    </jdbc>
  </generators>

  <type-solver>
  <!-- 
    <when test-resultset="scale > 0" java-type="java.math.BigDecimal" />
  -->
    <when test-resultset="precision &lt; 2" java-type="Byte" />
    <when test-resultset="scale > 0" java-type="Short" />
  </type-solver>

  <converter name="boolean_stored_as_int" java-type="java.lang.Boolean" java-raw-type="java.lang.Integer"
    class="app.IntegerBooleanConverter" />

<!-- 
  <table name="chars" />
  <table name="numbers" />
  <table name="dates" />
  <table name="binaries" />
  <table name="other" />
 -->

  <table name="account">
  <!--
    <column name="id" sequence="seq1" />
 -->    
    <column name="active" converter="boolean_stored_as_int" />

    <query method="activateBigAccounts">
      <parameter name="minBalance" java-type="java.lang.Long" />
      update account
      <bind name="x" value="'INV'" />
      <choose>
        <when test="minBalance > 50">type = #{x}</when>
        <when test="minBalance > 10">active = true</when>
      </choose>
    </query>

  </table>

