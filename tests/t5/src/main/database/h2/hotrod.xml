<hotrod>

  <generators>
  <jdbc base-dir="src/main/java"
        package="app.persistence"
        >
  </jdbc>
    <!--
    <jdbc>
-->
  </generators>

  <type-solver>
  <!-- 
    <when test-resultset="scale > 0" java-type="java.math.BigDecimal" />
  -->
    <when test-resultset="precision &lt; 20" java-type="Long" />
    <when test-resultset="scale > 0" java-type="Short" />
  </type-solver>

  <converter name="boolean_stored_as_int" java-type="java.lang.Boolean" java-raw-type="java.lang.Integer"
    class="app.IntegerBooleanConverter" />

  <converter name="account_type_stored_as_char" java-type="app.AccountTypeConverter.AccountType" java-raw-type="java.lang.String"
    class="app.AccountTypeConverter" />

  <converter name="coin_type_stored_as_char" java-type="java.lang.Integer" java-raw-type="java.lang.String"
    class="app.CoinTypeConverter" />

  <table name="product">
    <column name="pid_product" sequence="seq_product" />
  </table>

<!-- 
  <table name="branch" />
  <table name="other" />
  <view name="v_other" />
   -->

  <view name="employee_branch" />
  <table name="'abc_DEF'" />

  <table name="vehicle" />
  <table name="land" />

  <table name="coin">
    <column name="type" converter="coin_type_stored_as_char" />
  </table>
   
  <table name="account">
    <column name="balance" java-type="Double" />
    <column name="active" converter="boolean_stored_as_int" />
    <column name="type" converter="account_type_stored_as_char" />
  </table>
   
  <table name="employee">
    <column name="name" java-name="fullName" />
    <column name="vip" converter="boolean_stored_as_int" />
    <sequence name="employee_seq" method="getSequenceNextValue" />
    <sequence name="hired_seq" method="getHiredNextValue" />
    
    <select method="findVIPEmployees">
SELECT name, vip, id
FROM employee
WHERE branch_id = 101
    </select> 
<!-- 
     -->
    <query method="updateEmployees">
      update employee SET id = id
    </query>
    
  </table>

<!-- 
    <select method="getOthers" vo="Abv">
SELECT * FROM other
    </select> 
 -->
  <dao name="SalesDAO">
    <sequence name="hired_seq" method="getHiredNextValue" />


    <select method="findBigAccounts" vo="BigAccount">
       <column name="ibt_balance" java-name="grossBalance" />
select id, balance as ibt_balance,
  case when active then 'Active' else 'Inactive' end as status,
  cast(case when type = 'CHK' then balance * 1.5 else balance * 1.2 end as int) as score
from account
where balance >= 200
    </select>

    <query method="deleteAccounts">
      delete from account where type = 'SAV'
    </query>
    
  </dao>

