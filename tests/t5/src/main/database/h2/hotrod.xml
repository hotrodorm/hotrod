  <table name="binaries" />
  <table name="other" />
 -->

<!-- 
  update(Account row);                     // no OL
  update(Account row);                     // Version number
  update(Account row);                     // Timestamp
  updateOL(Account row, Account baseline); // Full row check
  
  update(Account values, Account filter);  // by example
  
  delete(int pk);                          // no OL
  delete(int pk, int versionNumber);       // Version number
  delete(int pk, LocalDateTime timestamp); // Timestamp
  deleteOL(Account baseline);              // Full row check

  delete(Account filter);                  // by example  
 -->

  <table name="account">
    <optimistic-locking strategy="timestamp" column="updated_at" />
  <!--
    <optimistic-locking strategy="version-number" column="version" />
    <optimistic-locking strategy="timestamp" column="updated_at" />
    <optimistic-locking strategy="full-row-check" />
    <column name="id" sequence="seq1" />
 -->    
    <column name="active" converter="boolean_stored_as_int" />
<!-- 
    <query method="activateBigAccounts">
      <parameter name="minBalance" java-type="java.lang.Long" />
      <parameter name="ids" java-type="java.util.List" jdbc-type="NUMERIC" />
      UPDATE account
      SET active = true
      WHERE id IN 
      <foreach item="id" collection="ids" open="(" separator=", " close=")">
        #{id}
      </foreach>
    </query>
 -->
 
    <select method="findBigAccounts">
select *
from account
where balance >= 300
    </select> 
 
  </table>

<!-- 
  <fragment file="./reporting.xml" />

  <fragment file="./test2.xml" />
 
  <table name="branch">
    <column name="is_vip" converter="boolean_stored_as_int" />
  </table>
 -->
 
    <!--
  -->
   <dao name="Reporting">

    <query method="activateBigAccounts">
      <parameter name="minBalance" java-type="java.lang.Long" />
      <parameter name="ids" java-type="java.util.List" jdbc-type="NUMERIC" />
      <parameter name="filter" java-type="java.lang.String" />
      UPDATE account
      SET active = true, balance = #{minBalance}
      WHERE id IN 
      <foreach item="id" collection="ids" open="(" separator=", " close=")">#{id}</foreach>
      AND ${filter}
    </query>
    
    <select method="findBigAccounts" vo="BigAccount">
select id, balance,
  case when active then 'Active' else 'Inactive' end as status,
  cast(case when type = 'CHK' then balance * 1.5 else balance * 1.2 end as int) as score
from account
where balance >= 300
    </select> 
       
  </dao>

</hotrod>
