<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mappers.test2.buscadorDAO">

  <!-- columns -->

  <sql id="columns">
    
  </sql>

  <sql id="columnsWithAlias">
    
  </sql>

  <!-- select method: findTareasPorFiltro -->

  <resultMap id="result_map_select_findTareasPorFiltro" type="app.daos.test2.FindTareasPorFiltroVO">
    <result property="id" column="ID" />
    <result property="name" column="NAME" />
  </resultMap>

  <select id="select_findTareasPorFiltro" resultMap="result_map_select_findTareasPorFiltro">
      select *
      from a
        <if test="idArea != null">
        left join b on b.aid = a.id
          <if test="idSector != null">
            where b.val is not null
          </if>
        </if>
  </select>

</mapper>
