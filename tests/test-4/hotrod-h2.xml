<?xml version="1.0"?>

<hotrod>

  <generators>
    <mybatis-spring>
      <daos package="app.daos" dao-suffix="DAO" vo-suffix="VO" abstract-vo-prefix="Abstract"
        abstract-vo-suffix="VO" />
      <mappers dir="mappers" />
    </mybatis-spring>
  </generators>

  <converter name="boolean_stored_as_int" java-type="java.lang.Boolean" java-raw-type="java.lang.Integer"
    class="app.IntegerBooleanConverter" />

<!--
  <table name="branch" />
-->

  <table name="employee">
    <column name="vip" converter="boolean_stored_as_int" />
    <sequence name="employee_seq" method="getSequenceNextValue" />
  </table>

</hotrod>
