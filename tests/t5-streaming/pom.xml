<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tests</groupId>
  <artifactId>t5-streaming</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>

    <debbie.version>1.3.3</debbie.version>
    
    <jdbcdrivergroupid>com.h2database</jdbcdrivergroupid>
    <jdbcdriverartifactid>h2</jdbcdriverartifactid>
    <jdbcdriverversion>2.2.224</jdbcdriverversion>
    
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.nocrala.tools.database</groupId>
      <artifactId>tartarus</artifactId>
      <version>3.2.12</version>
    </dependency>
    
    <dependency>
      <groupId>${jdbcdrivergroupid}</groupId>
      <artifactId>${jdbcdriverartifactid}</artifactId>
      <version>${jdbcdriverversion}</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <plugin>
        <groupId>org.nocrala.tools.database.debbie</groupId>
        <artifactId>debbie-maven-plugin</artifactId>
        <version>${debbie.version}</version>
        <configuration>
          <sourcedir>src/main/database/${subfolder}</sourcedir>
          <targetversion>1.0.0</targetversion>
          <jdbcdriverclass>${jdbcdriverclass}</jdbcdriverclass>
          <jdbcurl>${jdbcurl}</jdbcurl>
          <jdbcusername>${jdbcusername}</jdbcusername>
          <jdbcpassword>${jdbcpassword}</jdbcpassword>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>${jdbcdrivergroupid}</groupId>
            <artifactId>${jdbcdriverartifactid}</artifactId>
            <version>${jdbcdriverversion}</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>app.lobs.LobTests</mainClass>
          <arguments>
            <argument>${jdbcurl}</argument>
            <argument>${jdbcusername}</argument>
            <argument>${jdbcpassword}</argument>
          </arguments>
        </configuration>
      </plugin>

    </plugins>
  </build>

<!-- run as:
mvn -P oracle debbie:build && mvn -P oracle exec:java
mvn -P db2 debbie:build && mvn -P db2 exec:java
mvn -P postgresql debbie:build && mvn -P postgresql exec:java
mvn -P sqlserver debbie:build && mvn -P sqlserver exec:java
mvn -P mysql debbie:build && mvn -P mysql exec:java
mvn -P mariadb debbie:build && mvn -P mariadb exec:java
mvn -P h2 debbie:build && mvn -P h2 exec:java
-->

  <profiles>

    <profile>
      <id>oracle</id>
      <properties>
        <subfolder>oracle</subfolder>
        <jdbcdrivergroupid>com.oracle.database.jdbc</jdbcdrivergroupid>
        <jdbcdriverartifactid>ojdbc8</jdbcdriverartifactid>
        <jdbcdriverversion>23.9.0.25.07</jdbcdriverversion>
        <jdbcdriverclass>oracle.jdbc.driver.OracleDriver</jdbcdriverclass>
        <jdbcurl>jdbc:oracle:thin:@192.168.56.95:1521:orcl</jdbcurl>
        <jdbcusername>user1</jdbcusername>
        <jdbcpassword>pass1</jdbcpassword>
        <jdbcschema>public</jdbcschema>
      </properties>
    </profile>

    <profile>
      <id>db2</id>
      <properties>
        <subfolder>db2</subfolder>
        <jdbcdrivergroupid>com.ibm.db2</jdbcdrivergroupid>
        <jdbcdriverartifactid>jcc</jdbcdriverartifactid>
        <jdbcdriverversion>11.5.7.0</jdbcdriverversion>
        <jdbcdriverclass>com.ibm.db2.jcc.DB2Driver</jdbcdriverclass>
        <jdbcurl>jdbc:db2://192.168.56.44:50000/empusa</jdbcurl>
        <jdbcusername>user1</jdbcusername>
        <jdbcpassword>pass1</jdbcpassword>
        <jdbcschema>public</jdbcschema>
      </properties>
    </profile>

    <profile>
      <id>postgresql</id>
      <properties>
        <subfolder>postgresql</subfolder>
        <jdbcdrivergroupid>org.postgresql</jdbcdrivergroupid>
        <jdbcdriverartifactid>postgresql</jdbcdriverartifactid>
        <jdbcdriverversion>42.3.3</jdbcdriverversion>
        <jdbcdriverclass>org.postgresql.Driver</jdbcdriverclass>
        <jdbcurl>jdbc:postgresql://192.168.56.200:5416/hotrod</jdbcurl>
        <jdbcusername>user1</jdbcusername>
        <jdbcpassword>pass1</jdbcpassword>
        <jdbcschema>public</jdbcschema>
      </properties>
    </profile>

    <profile>
      <id>sqlserver</id>
      <properties>
        <subfolder>sqlserver</subfolder>
        <jdbcdrivergroupid>com.microsoft.sqlserver</jdbcdrivergroupid>
        <jdbcdriverartifactid>mssql-jdbc</jdbcdriverartifactid>
        <jdbcdriverversion>10.2.2.jre8</jdbcdriverversion>
        <jdbcdriverclass>com.microsoft.sqlserver.jdbc.SQLServerDriver</jdbcdriverclass>
        <jdbcurl>jdbc:sqlserver://192.168.56.51:1433;encrypt=true;trustServerCertificate=true</jdbcurl>
        <jdbcusername>admin</jdbcusername>
        <jdbcpassword>admin</jdbcpassword>
        <jdbccatalog>master</jdbccatalog>
        <jdbcschema>dbo</jdbcschema>
      </properties>
    </profile>

    <profile>
      <id>mysql</id>
      <properties>
        <subfolder>mysql</subfolder>
        <jdbcdrivergroupid>mysql</jdbcdrivergroupid>
        <jdbcdriverartifactid>mysql-connector-java</jdbcdriverartifactid>
        <jdbcdriverversion>8.0.28</jdbcdriverversion>
        <jdbcdriverclass>com.mysql.cj.jdbc.Driver</jdbcdriverclass>
        <jdbcurl>jdbc:mysql://192.168.56.200:3820/hotrod?useUnicode=true&amp;useJDBCCompliantTimezoneShift=true&amp;useLegacyDatetimeCode=false&amp;serverTimezone=UTC&amp;useSSL=false</jdbcurl>
        <jdbcusername>user1</jdbcusername>
        <jdbcpassword>pass1</jdbcpassword>
        <jdbccatalog>hotrod</jdbccatalog>
      </properties>
    </profile>

    <profile>
      <id>mariadb</id>
      <properties>
        <subfolder>mariadb</subfolder>
        <jdbcdrivergroupid>org.mariadb.jdbc</jdbcdrivergroupid>
        <jdbcdriverartifactid>mariadb-java-client</jdbcdriverartifactid>
        <jdbcdriverversion>2.2.5</jdbcdriverversion>
        <jdbcdriverclass>org.mariadb.jdbc.Driver</jdbcdriverclass>
        <jdbcurl>jdbc:mysql://192.168.56.200:3111/hotrod</jdbcurl>
        <jdbcusername>user1</jdbcusername>
        <jdbcpassword>pass1</jdbcpassword>
        <jdbccatalog>hotrod</jdbccatalog>
      </properties>
    </profile>

    <profile>
      <id>h2</id>
      <properties>
        <subfolder>h2</subfolder>
        <jdbcdrivergroupid>com.h2database</jdbcdrivergroupid>
        <jdbcdriverartifactid>h2</jdbcdriverartifactid>
        <jdbcdriverversion>2.2.224</jdbcdriverversion>
        <jdbcdriverclass>org.h2.Driver</jdbcdriverclass>
        <jdbcurl>jdbc:h2:mem:EXAMPLEDB;INIT=runscript from 'src/main/database/h2/1.0.0/build.sql';DB_CLOSE_DELAY=-1</jdbcurl>
        <jdbcusername>sa</jdbcusername>
        <jdbcpassword>""</jdbcpassword>
        <jdbcschema>PUBLIC</jdbcschema>
      </properties>
    </profile>

  </profiles>

</project>
